  "parser": "ArtefactForge",
  "description": "ArtefactForge's remote access events per host (RemoteAccess\\RemoteAccess.csv); raw only",
  "fileNames": [
    "^RemoteAccess\\.csv$"
  ],
  "requiredColumns": [
