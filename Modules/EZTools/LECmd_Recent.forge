Description: LNK files in Recent, per user (LECmd)
Category: LNKFiles
Author: ArtefactForge
Version: '1.0'
ExportFormat: csv
OutputName: LECmd_Recent
Requires: ['%root%\Users\%user%\AppData\Roaming\Microsoft\Windows\Recent\*.lnk']
Iterate: userprofile
Platform: windows
Priority: 51
Processors:
  -
    Executable: eztools\LECmd.exe
    CommandLine: -d "%root%\Users\%user%\AppData\Roaming\Microsoft\Windows\Recent" -q --csv "%destinationDirectory%" --csvf "%user%_LECmd_Recent.csv"
    ExportFormat: csv
    ExportFile: "%user%_LECmd_Recent.csv"
