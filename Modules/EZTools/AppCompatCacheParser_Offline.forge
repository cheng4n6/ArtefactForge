Description: ShimCache from collected SYSTEM hive
Category: ShimCache
Author: ArtefactForge
Version: '1.0'
ExportFormat: csv
OutputName: AppCompatCacheParser
Requires: ['%root%\Windows\System32\config\SYSTEM']
Scope: offlineonly
Platform: windows
Priority: 41
Processors:
  -
    Executable: eztools\AppCompatCacheParser.exe
    CommandLine: -f "%root%\Windows\System32\config\SYSTEM" --csv "%destinationDirectory%"
    NoLogsArgument: --nl
    ExportFormat: csv
