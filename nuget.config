<?xml version="1.0" encoding="utf-8"?>
<!--
  Names nuget.org as a package source, so a build does not depend on the machine's own NuGet
  settings: a fresh SDK install, or a config that only lists a company feed, otherwise fails
  restore with NU1100. Sources configured on the machine are kept, not replaced.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
