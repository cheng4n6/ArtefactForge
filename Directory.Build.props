<Project>

  <!--
    One version for every assembly. InformationalVersion picks up the git commit automatically
    (1.0.0+<sha>), which is what lets a manifest be traced back to the exact source that produced it.
  -->
  <PropertyGroup>
    <Version>0.3.0</Version>
    <Product>ArtefactForge</Product>
    <Description>Forensic artefact processing</Description>
  </PropertyGroup>

</Project>
